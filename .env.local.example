# Application Config
NODE_ENV=development
PORT=3000

# PostgreSQL Configuration (compose-local.yml / localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=coldchain_db

# Auth
JWT_SECRET=jwt_secret_key

# MongoDB Configuration (compose-local.yml / localhost)
MONGO_URI=mongodb://127.0.0.1:27018/coldchain

# Redis Configuration (compose-local.yml / localhost)
REDIS_HOST=localhost
REDIS_PORT=6379

# Web3 & Smart Contract (Local Hardhat Node: http://127.0.0.1:8545)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SEPOLIA_RPC_URL=http://127.0.0.1:8545
# Hardhat Account #0 default test private key
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
